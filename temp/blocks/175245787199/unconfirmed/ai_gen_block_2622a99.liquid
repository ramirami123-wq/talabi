{% doc %}
  @prompt
    اريد ان اضيف صورة من دون ان تعرض على جميع المتجر فقط في مكان واحد
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-single-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-single-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-single-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-single-image-placeholder-{{ ai_gen_id }} {
    background-color: #fafafa;
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-single-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-single-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-single-image-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-single-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-single-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="ai-single-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-single-image-empty-state-{{ ai_gen_id }}">
          أضف صورة هنا
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "صورة واحدة",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "الصورة"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "نسبة العرض إلى الارتفاع",
      "options": [
        {
          "value": "1/1",
          "label": "مربع (1:1)"
        },
        {
          "value": "4/3",
          "label": "أفقي (4:3)"
        },
        {
          "value": "16/9",
          "label": "عريض (16:9)"
        },
        {
          "value": "3/4",
          "label": "عمودي (3:4)"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "عرض الصورة على الكمبيوتر",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "استدارة الحواف",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "صورة واحدة"
    }
  ]
}
{% endschema %}
