{% doc %}
  @prompt
    I want the headER background to be transparent so I can add the image I want.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-transparent-header-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-transparent-header__background-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.header_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-transparent-header__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-transparent-header__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-transparent-header__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-transparent-header__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-transparent-header__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    justify-content: {{ block.settings.content_alignment }};
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-transparent-header__logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-transparent-header__nav-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.nav_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-transparent-header__nav-link-{{ ai_gen_id }} {
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.nav_font_size }}px;
    font-weight: {{ block.settings.nav_font_weight }};
    transition: opacity 0.3s ease;
  }

  .ai-transparent-header__nav-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .ai-transparent-header__background-{{ ai_gen_id }} {
      height: {{ block.settings.header_height | times: 0.6 }}px;
    }

    .ai-transparent-header__logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.7 }}px;
    }

    .ai-transparent-header__nav-{{ ai_gen_id }} {
      gap: {{ block.settings.nav_gap | times: 0.5 }}px;
    }

    .ai-transparent-header__nav-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.nav_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<transparent-header-{{ ai_gen_id }}
  class="ai-transparent-header-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-transparent-header__background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-transparent-header__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-transparent-header__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-transparent-header__empty-state-{{ ai_gen_id }}">
          Add your background image
        </div>
      </div>
    {% endif %}

    <div class="ai-transparent-header__content-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          loading="lazy"
          class="ai-transparent-header__logo-{{ ai_gen_id }}"
        >
      {% endif %}

      {% if block.settings.show_navigation %}
        <nav>
          <ul class="ai-transparent-header__nav-{{ ai_gen_id }}">
            {% if block.settings.nav_link_1_text != blank %}
              <li>
                <a
                  href="{{ block.settings.nav_link_1_url }}"
                  class="ai-transparent-header__nav-link-{{ ai_gen_id }}"
                >
                  {{ block.settings.nav_link_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.nav_link_2_text != blank %}
              <li>
                <a
                  href="{{ block.settings.nav_link_2_url }}"
                  class="ai-transparent-header__nav-link-{{ ai_gen_id }}"
                >
                  {{ block.settings.nav_link_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.nav_link_3_text != blank %}
              <li>
                <a
                  href="{{ block.settings.nav_link_3_url }}"
                  class="ai-transparent-header__nav-link-{{ ai_gen_id }}"
                >
                  {{ block.settings.nav_link_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.nav_link_4_text != blank %}
              <li>
                <a
                  href="{{ block.settings.nav_link_4_url }}"
                  class="ai-transparent-header__nav-link-{{ ai_gen_id }}"
                >
                  {{ block.settings.nav_link_4_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </nav>
      {% endif %}
    </div>
  </div>
</transparent-header-{{ ai_gen_id }}>

<script>
  (function() {
    class TransparentHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('transparent-header-{{ ai_gen_id }}', TransparentHeader{{ ai_gen_id }});
  })();
</script>

