{% comment %} talabi-announcement-slider.liquid {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .talabi-announcement-bar {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .talabi-slider-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .talabi-slide {
    position: absolute;
    width: 100%;
    text-align: center;
    font-size: {{ section.settings.text_size }}px;
    font-weight: 400;
    letter-spacing: 0.03em;
    top: 50%;
    transform: translateY(-50%) translateX(100%);
    opacity: 0;
    transition: transform 0.5s ease, opacity 0.5s ease;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .talabi-slide.active {
    transform: translateY(-50%) translateX(0%);
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .talabi-slide.exit {
    transform: translateY(-50%) translateX(-100%);
    opacity: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .talabi-announcement-bar {
      height: {{ section.settings.mobile_height }}px;
    }

    #shopify-section-{{ section.id }} .talabi-slide {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }
</style>

<div class="talabi-announcement-bar">
  <div class="talabi-slider-wrapper">
    {% for block in section.blocks %}
      <div class="talabi-slide" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;

    const slides = section.querySelectorAll('.talabi-slide');
    if (!slides.length) return;

    let current = 0;
    slides[0].classList.add('active');

    function showSlide(index) {
      const prev = (index - 1 + slides.length) % slides.length;

      slides[prev].classList.remove('active');
      slides[prev].classList.add('exit');

      setTimeout(() => {
        slides[prev].classList.remove('exit');
      }, 500);

      slides[index].classList.add('active');
    }

    setInterval(() => {
      current = (current + 1) % slides.length;
      showSlide(current);
    }, {{ section.settings.speed | times: 1000 }});
  });
</script>

{% schema %}
{
  "name": "Announcement Slider",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9E8E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4A3F3F"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 28,
      "max": 60,
      "step": 1,
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 26,
      "max": 50,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Desktop text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile text size",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slide change speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Delivery all over Lebanon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Slider",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Cash on Delivery Available"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Limited Time Offer: 30% OFF"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Fast Delivery Across Lebanon"
          }
        }
      ]
    }
  ]
}
{% endschema %}